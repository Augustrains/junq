           " T=", TIME_NOW,
           " shooter=", aEngagement.FiringPlatformName(),
           " weapon_system=", aEngagement.WeaponSystemName(),
           " weapon_platform=", aEngagement.WeaponPlatformName(),
           " target=", aEngagement.TargetPlatformName());
end_script

